{
  "name": "xp-investimentos-mcp",
  "version": "0.3.0",
  "description": "Local, read-only MCP server for personal XP Investimentos portfolio analysis",
  "license": "MIT",
  "author": "Felipe Lima",
  "homepage": "https://github.com/Satsuj1n/xp-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satsuj1n/xp-mcp.git"
  },
  "bugs": {
